# Copy these values into your local shell environment. Never commit a real key.
DEEPSEEK_API_KEY=
# macOS local default: project-only credential stored under this Keychain service.
DEEPSEEK_KEYCHAIN_SERVICE=auto-research-deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-pro
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=180

# MinerU tokens must be stored in macOS Keychain service auto-research-mineru.
# Do not add a MINERU_TOKEN value to this file.
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SECONDS=180
