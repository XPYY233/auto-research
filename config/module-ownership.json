{
  "schema": "auto-research-module-ownership-v1",
  "updated_at": "2026-08-27",
  "allowed_statuses": ["stable", "experimental", "compatibility", "retired"],
  "modules": [
    {
      "id": "scientific-evidence-core",
      "paths": ["src/auto_research/evidence"],
      "owner": "shared-evidence-core",
      "status": "stable",
      "authority": "schema-v12 evidence, four public evidence types, extraction and quality gates"
    },
    {
      "id": "librarian-v3-compatibility",
      "paths": ["src/auto_research/evidence/agent_runtime.py", "src/auto_research/evidence/librarian_*.py"],
      "owner": "shared-librarian-core",
      "status": "compatibility",
      "authority": "historical deterministic recall and signed brief compatibility only; production desktop AI must not execute this loop"
    },
    {
      "id": "deepseek-harness-runtime",
      "paths": ["src/auto_research/ai/harness_*.py", "src/auto_research/evidence/harness_*.py", "config/auto-research-harness*.yml"],
      "owner": "shared-ai-runtime",
      "status": "stable",
      "authority": "pinned Harness composition, read-only tool gateway, prepared-action execution, citation and budget validation"
    },
    {
      "id": "ai-provider-readiness",
      "paths": ["src/auto_research/ai/provider_registry.py", "src/auto_research/ai/custom_provider.py", "src/auto_research/ai/capability_verifier.py", "src/auto_research/settings/ai_readiness.py", "src/auto_research/settings/ai_runtime_state.py"],
      "owner": "shared-ai-runtime",
      "status": "experimental",
      "authority": "ai-readiness-v1, provider connection, per-scope capability verification, safe custom HTTPS endpoint and stable path-free error lineage"
    },
    {
      "id": "federated-search",
      "paths": ["src/auto_research/evidence/federated_search.py", "src/auto_research/evidence/federated_search_session.py"],
      "owner": "shared-search-core",
      "status": "stable",
      "authority": "official and private immutable source lifecycle and ranking"
    },
    {
      "id": "official-package-runtime",
      "paths": ["src/auto_research/product/evidence_package.py", "src/auto_research/product/official_package_store.py", "src/auto_research/product/portable_repository.py"],
      "owner": "shared-product-runtime",
      "status": "stable",
      "authority": "signed official package verification, immutable repository audit, activation and rollback"
    },
    {
      "id": "user-transfer-runtime",
      "paths": ["src/auto_research/product/transfer_package.py", "src/auto_research/product/package_transfer_*.py", "src/auto_research/product/package_payload_sources.py"],
      "owner": "shared-product-runtime",
      "status": "experimental",
      "authority": "untrusted user transfer planning, sanitization, archive, integrity and activation"
    },
    {
      "id": "package-center",
      "paths": ["src/auto_research/product/package_center.py", "src/auto_research/product/package_center_models.py"],
      "owner": "shared-product-runtime",
      "status": "experimental",
      "authority": "path-free package plans, jobs, export and import orchestration"
    },
    {
      "id": "dataset-bundle-runtime",
      "paths": ["src/auto_research/product/dataset_bundle.py", "src/auto_research/product/dataset_bundle_sources.py", "src/auto_research/product/dataset_export_service.py"],
      "owner": "shared-product-runtime",
      "status": "stable",
      "authority": "dataset-bundle-v1 JSONL/Parquet projection, deterministic paper split, data card and atomic archive publication"
    },
    {
      "id": "scientific-release-audit",
      "paths": ["src/auto_research/evidence/scientific_release_audit.py"],
      "owner": "scientific-quality",
      "status": "stable",
      "authority": "human-gold scientific metrics and leakage/duplicate release gates; never inferred from software test success"
    },
    {
      "id": "personal-data-core",
      "paths": ["src/auto_research/personal"],
      "owner": "shared-personal-core",
      "status": "stable",
      "authority": "bounded tabular preview, AI suggestions, reviewed import, private repository and transfer merge"
    },
    {
      "id": "desktop-application-facade",
      "paths": ["src/auto_research/desktop"],
      "owner": "shared-desktop-contract",
      "status": "experimental",
      "authority": "platform-neutral route catalog, request context and error projection"
    },
    {
      "id": "shared-desktop-ui",
      "paths": [
        "src/auto_research/evidence/web/index.html",
        "src/auto_research/evidence/web/app.css",
        "src/auto_research/evidence/web/workbench.css",
        "src/auto_research/evidence/web/ai_consent.js",
        "src/auto_research/evidence/web/document_tab_store.js",
        "src/auto_research/evidence/web/pane_layout_controller.js",
        "src/auto_research/evidence/web/workspace_layout_controller.js",
        "src/auto_research/evidence/web/fusion_pdf_controller.js",
        "src/auto_research/evidence/web/fusion_ai_experience.js",
        "src/auto_research/evidence/web/fusion_package_center.js",
        "src/auto_research/evidence/web/fusion_personal_import.js",
        "src/auto_research/evidence/web/fusion_review.js"
      ],
      "owner": "shared-frontend",
      "status": "experimental",
      "authority": "single Fusion workbench recovery path; workbench-recovery-contract-v1 governs hierarchy, DocumentTabStore governs document identity, and the UI cannot become stable before installed-App visual and workflow acceptance"
    },
    {
      "id": "legacy-web-compatibility",
      "paths": [
        "src/auto_research/evidence/web/app.js",
        "src/auto_research/evidence/web/desktop_product.js",
        "src/auto_research/evidence/web/package_center.js",
        "src/auto_research/evidence/web/workbench.js"
      ],
      "owner": "maintenance",
      "status": "compatibility",
      "authority": "non-production compatibility resources retained only while safe-update, route, permission and migration consumers are moved to the Fusion authority; never a second supported UI"
    },
    {
      "id": "macos-shell",
      "paths": ["desktop/macos"],
      "owner": "macos-platform",
      "status": "experimental",
      "authority": "native lifecycle, protected loopback, file tokens, credential adapter and App packaging only"
    },
    {
      "id": "windows-shell",
      "paths": ["desktop/windows"],
      "owner": "windows-platform",
      "status": "experimental",
      "authority": "Windows lifecycle, native file tokens, Credential Manager and installer only"
    },
    {
      "id": "browser-workbench-compatibility",
      "paths": ["scripts/start_evidence_ui.command", "scripts/start_readonly_ngrok.command"],
      "owner": "maintenance",
      "status": "retired",
      "authority": "migration notices and permission regression only; never a user product"
    }
  ]
}
